# =============================================================================
# .env.example —— 环境变量集中登记表（T-0103，SRS SEC-5 / NFR-3，project_rules §5.6）
#
# 用法（新成员首次启动，DoD 口径）：
#   1. 复制本文件为 .env：  cp .env.example .env        （Windows: copy .env.example .env）
#   2. 启动本地 Supabase：   docker compose up -d        （密钥已填入本地开发默认值，与 docker-compose.yml / kong.yml 同源）
#   3. 启动应用：            pnpm install && pnpm dev     （默认 http://localhost:3000）
#
# 命名红线（SEC-5 / project_rules §5.5）：
#   - SUPABASE_SERVICE_ROLE_KEY、DEEPSEEK_API_KEY 等任何服务端密钥【禁止】加 NEXT_PUBLIC_ 前缀
#   - NEXT_PUBLIC_ 前缀仅允许匿名 key（NEXT_PUBLIC_SUPABASE_ANON_KEY）
# 新增环境变量必须同步登记到本文件并写注释（project_rules §5.6）。
# 本文件含本地开发默认密钥（非真实密钥，与 docker-compose.yml / kong.yml 同源，已在库内公开）；
# 生产/试用部署必须重新生成（node scripts/generate-supabase-keys.mjs）并替换。
# .env 已被 .gitignore 排除，不得入库。
# =============================================================================

# -----------------------------------------------------------------------------
# 一、本地 Supabase（Docker Compose，v2.4 不启 Auth，仅 Postgres + Storage + REST + 网关）
#   以下值与 docker-compose.yml 内置默认值完全一致；docker-compose.yml 用 ${VAR:-默认}
#   语法读取， .env 留空或不改时容器取这些默认值。生产部署必须全部替换。
# -----------------------------------------------------------------------------

# Postgres 超级用户密码（CI 使用 postgres；本地 docker-compose 使用下方默认值）
POSTGRES_PASSWORD=local-dev-postgres-password-change-me

# JWT 签名密钥（HS256，32 字节 base64）
JWT_SECRET=WYq4WaAyakNPiCu0dwRWiZPAVQ6+X/7NnPEU0qx2eJY=

# 匿名 key：payload.role = anon，受 RLS 约束（anon 角色仅能访问策略允许的行）
# Kong 网关 key-auth 凭据与此值必须一致（见 supabase/kong.yml）
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlIiwiaWF0IjoxNzg4NDAyMDk4LCJleHAiOjIxMDM3NjIwOTh9.Qfp68vwlwBfN6gNcOJijI3pMaRaXhUnoucvlb32fQ

# 服务角色 key：payload.role = service_role，绕过 RLS（仅服务端使用，SEC-5 红线）
# Kong 网关 key-auth 凭据与此值必须一致（见 supabase/kong.yml）
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoic2VydmljZV9yb2xlIiwiaXNzIjoic3VwYWJhc2UiLCJpYXQiOjE3ODg0MDIwOTgsImV4cCI6MjEwMzc2MjA5OH0.-pHVZ2WJey7isLriraJ5XJHXMKipF8iHXSJoU1ffoPI

# Supabase 本地端口（compose 默认：Postgres 5432 / Kong 网关 8000）
POSTGRES_PORT=5432
KONG_HTTP_PORT=8000

# 外部可见的 Supabase 网关地址（storage 服务拼接签名 URL 用；局域网部署改为 http://<主机IP>:8000）
SUPABASE_PUBLIC_URL=http://localhost:8000

# JWT 有效期（秒）
JWT_EXPIRY=3600

# -----------------------------------------------------------------------------
# 二、应用侧 Supabase 连接（指向本机 Docker 网关 :8000）
#   SUPABASE_SERVICE_ROLE_KEY 与上方 SERVICE_ROLE_KEY 同值（应用侧变量名，代码示例 §8 用此名）；
#   NEXT_PUBLIC_SUPABASE_ANON_KEY 与上方 ANON_KEY 同值（浏览器侧，SEC-5 仅允许匿名 key）。
# -----------------------------------------------------------------------------

# 服务端连接 URL（REST/Storage 直连，见 lib/supabase/server.ts 与《代码示例.md》§4）
SUPABASE_URL=http://localhost:8000

# 浏览器端连接 URL（SEC-5：NEXT_PUBLIC_ 前缀仅允许匿名 key，见 lib/supabase/client.ts）
NEXT_PUBLIC_SUPABASE_URL=http://localhost:8000
# 与上方 ANON_KEY 同值
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlIiwiaWF0IjoxNzg4NDAyMDk4LCJleHAiOjIxMDM3NjIwOTh9.Qfp68vwlwBfN6gNcOJijI3pMaRaXhUnoucvlb32fQ

# 服务角色 key：服务端专用（supabase db 管理、签名 URL 等），【禁止】暴露到浏览器（SEC-5 红线）
# 与上方 SERVICE_ROLE_KEY 同值
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoic2VydmljZV9yb2xlIiwiaXNzIjoic3VwYWJhc2UiLCJpYXQiOjE3ODg0MDIwOTgsImV4cCI6MjEwMzc2MjA5OH0.-pHVZ2WJey7isLriraJ5XJHXMKipF8iHXSJoU1ffoPI

# -----------------------------------------------------------------------------
# 三、单用户 seed（v2.4：无认证，全部 API 直接服务 seed 预设的唯一学生）
#   由迁移 0001（T-0104）seed 脚本写入固定 UUID（T-0104 已落地，值已填入）。
#   改动红线上方同值区：迁移 0001 seed INSERT / 本变量 / docker-compose.yml
#   rest.PGRST_DB_PRE_CONFIG 默认值 —— 三处严禁分叉。
# -----------------------------------------------------------------------------

# seed 预设唯一学生的固定 user_id（迁移 0001 已写入；RLS 固定过滤依据，代码示例 §9 同口径）
SEED_STUDENT_ID=cd283caa-17c3-4fbb-a579-e41b3e425c16

# -----------------------------------------------------------------------------
# 四、LLM（lib/ai/provider.ts，T-0301；主：DeepSeek，备份：任意 OpenAI 兼容端点）
# -----------------------------------------------------------------------------

# DeepSeek API 密钥（服务端专用，SEC-5 红线；【禁止】加 NEXT_PUBLIC_ 前缀）
DEEPSEEK_API_KEY=

# 选择生效 provider：deepseek（默认）| backup
LLM_PROVIDER=deepseek

# 备份 provider（OpenAI 兼容接口）：base URL / API key / 模型名（默认回退 deepseek-v4-flash）
BACKUP_LLM_BASE_URL=
BACKUP_LLM_API_KEY=
BACKUP_LLM_MODEL=

# -----------------------------------------------------------------------------
# 五、ASR 转写（API-10，T-0305；云端 Whisper 兼容服务，W5 选型 T-0318 后填真实值）
#   —— 选型完成前留空：开发/CI 一律 MSW fixture 模拟，不真调（project_rules §7.2）
# -----------------------------------------------------------------------------

# Whisper 兼容服务端点（必填，形如 https://<供应商>/v1/audio/transcriptions）
ASR_BASE_URL=

# 供应商 API 密钥（服务端专用；传参走 lib/ai，禁止浏览器直连）
ASR_API_KEY=

# 转写模型名（默认 whisper-1）
ASR_MODEL=whisper-1

# -----------------------------------------------------------------------------
# 六、测试 / 验收（QUOTA-4：验收与 CI 环境豁免配额，usage.ts 仍按 users.role 判定）
# -----------------------------------------------------------------------------

# 集成测试数据库连接串（CI 与本地等价物，见 ci.yml；本地可用 docker compose 的 db:5432）
# 密码与上方 POSTGRES_PASSWORD 默认值一致；CI 中由 ci.yml 覆盖为 postgres
TEST_DATABASE_URL=postgres://postgres:local-dev-postgres-password-change-me@localhost:5432/postgres

# 配额豁免开关（true 时豁免全部限额 QUOTA-1～5，仅验收/CI 用，验收完毕必须恢复 false）
QUOTA_BYPASS=false

# E2E 目标地址（Playwright webServer，默认 http://localhost:3000）
E2E_BASE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# 七、应用信息（可选）
# -----------------------------------------------------------------------------

# 前端展示/上报的发布版本号（写入 content_versions.released_version 等，默认 null）
NEXT_PUBLIC_APP_VERSION=

# 关闭 Next.js 遥测（CI 已设；本地默认关闭）
NEXT_TELEMETRY_DISABLED=1